            )
        }

        when {
            params {
                input               = samplesheet_path
                hic                 = hicParam
                hic_map_combinations= 'HY1 HY2 HY1:HY2'
                outdir              = "$outputDir"
            }
        }

        then {
            def stable_path = getAllFilesFromDir(
                params.outdir,
                false,
                [
                    'pipeline_info/*.{html,json,txt,yml}',
                    'hic/fastp/*.fastq.gz',
                    'hic/fastp/*.html',
                    'hic/fastp/*.log',
